{
  "version": "taxonomy-v1",
  "id_column": "REPLACE_WITH_ID_COLUMN",
  "text_columns": [
    "REPLACE_WITH_TEXT_COLUMN"
  ],
  "auto_accept_threshold": 0.6,
  "default_review_status": "needs_review",
  "taxonomy_design": {
    "strategy": "representative_plus_atomic_attributes",
    "representative_axis": "primary_class",
    "secondary_axes": [
      "secondary_class"
    ],
    "attribute_axes": [
      "life_stage",
      "food_form"
    ],
    "representative_axis_forbidden_values": [],
    "disjoint_axis_value_groups": [
      {
        "owner_axis": "REPLACE_WITH_ATTRIBUTE_AXIS_IF_NEEDED",
        "excluded_from_axes": [
          "primary_class"
        ],
        "note": "Use when overloaded source category values belong to an attribute axis and must not appear in the representative axis."
      }
    ],
    "notes": [
      "Rename axes for the domain. For products this might be primary_category, secondary_category, item_type, health_function, life_stage, food_form, target_species, commercial_status.",
      "The representative axis must be single-value and required or review_if_empty.",
      "Default every derived output column to one semantic property and one selected value.",
      "Do not create broad catch-all axes such as subcategory_tag or attribute_tags when source values can be split into atomic columns.",
      "Do not allow a value owned by an attribute axis to also appear in the representative axis. Add fallback rules or route rows to review instead.",
      "Use multi_value only with an explicit multi_value_exception explaining why the property cannot be split safely."
    ]
  },
  "feature_contract": {
    "retrieval_axes": [
      "primary_class",
      "secondary_class"
    ],
    "ranking_axes": [
      "life_stage",
      "food_form"
    ],
    "filter_axes": [
      "primary_class",
      "life_stage",
      "food_form"
    ],
    "exclusion_axes": [],
    "fallback_axes": [
      "primary_class"
    ],
    "notes": [
      "Use retrieval_axes to narrow candidates.",
      "Use ranking_axes for similarity, preference, or LLM recommendation context.",
      "Use exclusion_axes for unsafe, incompatible, or irrelevant matches."
    ]
  },
  "derived_output": {
    "identity_columns": [
      "REPLACE_WITH_PRODUCT_ID_OR_NAME_COLUMN"
    ],
    "drop_source_columns": [
      "REPLACE_WITH_OLD_CATEGORY_COLUMN"
    ],
    "audit_columns": "minimal",
    "notes": [
      "Keep only source columns required to identify or display the row, such as product_id, sku, goods_name, product_name, name, or title.",
      "Do not copy the full source table into the derived output.",
      "Use a separate audit output when evidence, rule_ids, and axis_values are needed for review."
    ]
  },
  "axes": {
    "primary_class": {
      "description": "Rename for the domain. The one best representative class for each row.",
      "role": "primary",
      "used_for_retrieval": true,
      "used_for_ranking": true,
      "used_for_filtering": true,
      "used_for_exclusion": false,
      "feature_weight_hint": 1.0,
      "multi_value": false,
      "required": true,
      "review_if_empty": true,
      "max_values": 1,
      "values": {
        "example_value": {
          "description": "Replace with a primary class supported by the dataset.",
          "confidence": 0.8,
          "priority": 0,
          "source_columns": [
            "REPLACE_WITH_TEXT_COLUMN"
          ],
          "keywords": [
            "example keyword"
          ],
          "negative_keywords": [],
          "regex": [],
          "exact_values": {},
          "numeric_ranges": {},
          "all_of": [],
          "any_of": [],
          "none_of": [],
          "rule_id": "primary_class.example_value.keyword"
        }
      }
    },
    "secondary_class": {
      "description": "Rename for the domain. A narrower subtype when the source data supports it.",
      "role": "secondary",
      "used_for_retrieval": true,
      "used_for_ranking": true,
      "used_for_filtering": true,
      "used_for_exclusion": false,
      "feature_weight_hint": 0.7,
      "multi_value": false,
      "required": false,
      "review_if_empty": false,
      "max_values": 1,
      "values": {
        "example_subtype": {
          "description": "Replace with a narrower subtype.",
          "confidence": 0.75,
          "priority": 0,
          "source_columns": [
            "REPLACE_WITH_TEXT_COLUMN"
          ],
          "keywords": [
            "example subtype keyword"
          ],
          "negative_keywords": [],
          "regex": [],
          "exact_values": {},
          "numeric_ranges": {},
          "all_of": [],
          "any_of": [],
          "none_of": [],
          "rule_id": "secondary_class.example_subtype.keyword"
        }
      }
    },
    "life_stage": {
      "description": "Rename for the domain. One atomic lifecycle or age-stage property.",
      "role": "attribute",
      "used_for_retrieval": false,
      "used_for_ranking": true,
      "used_for_filtering": true,
      "used_for_exclusion": false,
      "feature_weight_hint": 0.5,
      "multi_value": false,
      "required": false,
      "review_if_empty": false,
      "max_values": 1,
      "values": {
        "example_life_stage": {
          "description": "Replace with an observed lifecycle value.",
          "confidence": 0.7,
          "priority": 0,
          "source_columns": [
            "REPLACE_WITH_TEXT_COLUMN"
          ],
          "keywords": [
            "example life stage keyword"
          ],
          "negative_keywords": [],
          "regex": [],
          "exact_values": {},
          "numeric_ranges": {},
          "all_of": [],
          "any_of": [],
          "none_of": [],
          "rule_id": "life_stage.example_life_stage.keyword"
        }
      }
    },
    "food_form": {
      "description": "Rename for the domain. One atomic form-factor or package/form property.",
      "role": "attribute",
      "used_for_retrieval": false,
      "used_for_ranking": true,
      "used_for_filtering": true,
      "used_for_exclusion": false,
      "feature_weight_hint": 0.5,
      "multi_value": false,
      "required": false,
      "review_if_empty": false,
      "max_values": 1,
      "values": {
        "example_form": {
          "description": "Replace with an observed form-factor value.",
          "confidence": 0.7,
          "priority": 0,
          "source_columns": [
            "REPLACE_WITH_TEXT_COLUMN"
          ],
          "keywords": [
            "example form keyword"
          ],
          "negative_keywords": [],
          "regex": [],
          "exact_values": {},
          "numeric_ranges": {},
          "all_of": [],
          "any_of": [],
          "none_of": [],
          "rule_id": "food_form.example_form.keyword"
        }
      }
    }
  }
}
